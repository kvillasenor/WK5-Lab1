{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    },
    "dueDate": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": ["Low", "Medium", "High"]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "completed",
    "dueDate",
    "priority",
    "createdAt",
    "updatedAt"
  ]
}